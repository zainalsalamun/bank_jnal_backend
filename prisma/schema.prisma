generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING
  BLOCKED
}

enum Role {
  CUSTOMER
  SUPER_ADMIN
  OPERATOR
  CONTENT_ADMIN
  VIEWER
  MERCHANT_ADMIN
}

enum MerchantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum MerchantRole {
  OWNER
  MANAGER
  CASHIER
}

model User {
  id            String    @id @default(uuid())
  fullName      String    @map("full_name")
  phone         String    @unique
  email         String    @unique
  passwordHash  String    @map("password_hash")
  pinHash       String?   @map("pin_hash")
  status        UserStatus @default(PENDING)
  role          Role      @default(CUSTOMER)
  isVerified    Boolean   @default(false) @map("is_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  pockets       Pocket[]
  cards         Card[]
  shortcuts     UserShortcut[]
  transactions  Transaction[] @relation("UserTransactions")
  savedAccounts SavedAccount[]
  merchants     Merchant[]
  merchantStaff MerchantStaff[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum PocketType {
  MAIN
  SAVING
  INVESTMENT
  CHARITY
}

model Pocket {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String
  accountNumber String    @unique @map("account_number")
  type          PocketType
  balance       Decimal   @default(0.00) @db.Decimal(18, 2)
  targetAmount  Decimal?  @db.Decimal(18, 2) @map("target_amount")
  isPrimary     Boolean   @default(false) @map("is_primary")
  createdAt     DateTime  @default(now()) @map("created_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards         Card[]
  merchants     Merchant[]
  
  sourceTransactions Transaction[] @relation("SourcePocket")
  destTransactions   Transaction[] @relation("DestPocket")

  @@map("pockets")
}

enum TransactionType {
  TRANSFER_IN
  TRANSFER_OUT
  QRIS
  TOP_UP
  BILL_PAYMENT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

model Transaction {
  id                  String    @id @default(uuid())
  reference           String    @unique
  userId              String    @map("user_id")
  sourcePocketId      String?   @map("source_pocket_id")
  destinationPocketId String?   @map("destination_pocket_id")
  type                TransactionType
  amount              Decimal   @db.Decimal(18, 2)
  adminFee            Decimal   @default(0.00) @db.Decimal(18, 2) @map("admin_fee")
  status              TransactionStatus @default(PENDING)
  description         String?
  recipientName       String?   @map("recipient_name")
  recipientBank       String?   @map("recipient_bank")
  recipientAccount    String?   @map("recipient_account")
  idempotencyKey      String?   @map("idempotency_key")
  failureReason       String?   @map("failure_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  completedAt         DateTime? @map("completed_at")

  user                User      @relation("UserTransactions", fields: [userId], references: [id])
  sourcePocket        Pocket?   @relation("SourcePocket", fields: [sourcePocketId], references: [id])
  destPocket          Pocket?   @relation("DestPocket", fields: [destinationPocketId], references: [id])

  @@map("transactions")
}

enum CardType {
  DIGITAL
  PHYSICAL
}

enum CardStatus {
  ACTIVE
  FROZEN
  BLOCKED
  EXPIRED
}

model Card {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  pocketId      String    @map("pocket_id")
  cardType      CardType  @map("card_type")
  cardName      String    @map("card_name") @default("Kartu Digital J-NAL")
  maskedNumber  String    @map("masked_number")
  expiryMonth   Int       @map("expiry_month")
  expiryYear    Int       @map("expiry_year")
  dailyLimit    Decimal   @default(10000000.00) @db.Decimal(18, 2) @map("daily_limit")
  status        CardStatus @default(ACTIVE)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pocket        Pocket    @relation(fields: [pocketId], references: [id])

  @@map("cards")
}

model QrisMerchant {
  id            String    @id @default(uuid())
  merchantName  String    @map("merchant_name")
  merchantId    String    @unique @map("merchant_id")
  city          String
  isActive      Boolean   @default(true) @map("is_active")

  @@map("qris_merchants")
}

model Merchant {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  pocketId      String         @map("pocket_id")
  name          String
  brandName     String?        @map("brand_name")
  category      String
  description   String?
  logoUrl       String?        @map("logo_url")
  address       String?
  city          String         @default("Jakarta")
  postalCode    String?        @map("postal_code")
  phone         String
  email         String?
  status        MerchantStatus @default(ACTIVE)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pocket        Pocket         @relation(fields: [pocketId], references: [id])
  outlets       MerchantOutlet[]
  staff         MerchantStaff[]
  products      MerchantProduct[]
  orders        MerchantOrder[]

  @@map("merchants")
}

model MerchantOutlet {
  id            String         @id @default(uuid())
  merchantId    String         @map("merchant_id")
  name          String
  address       String
  city          String
  qrisCode      String         @unique @map("qris_code")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  staff         MerchantStaff[]
  orders        MerchantOrder[]

  @@map("merchant_outlets")
}

model MerchantStaff {
  id            String         @id @default(uuid())
  merchantId    String         @map("merchant_id")
  outletId      String?        @map("outlet_id")
  userId        String?        @map("user_id")
  fullName      String         @map("full_name")
  phone         String
  pinHash       String         @map("pin_hash")
  role          MerchantRole   @default(CASHIER)
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  outlet        MerchantOutlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders        MerchantOrder[]

  @@map("merchant_staff")
}

model MerchantProduct {
  id            String         @id @default(uuid())
  merchantId    String         @map("merchant_id")
  name          String
  category      String         @default("General")
  price         Decimal        @db.Decimal(18, 2)
  description   String?
  imageUrl      String?        @map("image_url")
  sku           String?
  isAvailable   Boolean        @default(true) @map("is_available")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems    MerchantOrderItem[]

  @@map("merchant_products")
}

model MerchantOrder {
  id            String         @id @default(uuid())
  orderNumber   String         @unique @map("order_number")
  merchantId    String         @map("merchant_id")
  outletId      String?        @map("outlet_id")
  staffId       String?        @map("staff_id")
  totalAmount   Decimal        @db.Decimal(18, 2) @map("total_amount")
  discountAmount Decimal       @default(0.00) @db.Decimal(18, 2) @map("discount_amount")
  taxAmount     Decimal        @default(0.00) @db.Decimal(18, 2) @map("tax_amount")
  finalAmount   Decimal        @db.Decimal(18, 2) @map("final_amount")
  status        TransactionStatus @default(PENDING)
  paymentMethod String         @default("QRIS_DYNAMIC") @map("payment_method")
  transactionRef String?       @unique @map("transaction_ref")
  customerName  String?        @map("customer_name")
  note          String?
  paidAt        DateTime?      @map("paid_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  outlet        MerchantOutlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
  staff         MerchantStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  items         MerchantOrderItem[]

  @@map("merchant_orders")
}

model MerchantOrderItem {
  id            String          @id @default(uuid())
  orderId       String          @map("order_id")
  productId     String?         @map("product_id")
  productName   String          @map("product_name")
  price         Decimal         @db.Decimal(18, 2)
  quantity      Int             @default(1)
  subtotal      Decimal         @db.Decimal(18, 2)

  order         MerchantOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       MerchantProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("merchant_order_items")
}

enum NotificationType {
  TRANSACTION
  SECURITY
  PROMOTION
  SYSTEM
}

model Notification {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id")
  title      String
  message    String    @db.Text
  type       NotificationType
  isRead     Boolean   @default(false) @map("is_read")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

enum PromoStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

model Promotion {
  id          String    @id @default(uuid())
  title       String
  description String    @db.Text
  imageUrl    String?   @map("image_url")
  status      PromoStatus @default(DRAFT)
  startAt     DateTime  @map("start_at")
  endAt       DateTime  @map("end_at")

  @@map("promotions")
}

model UserShortcut {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  code      String
  position  Int

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_shortcuts")
}

model SavedAccount {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  bankCode        String    @map("bank_code")
  accountNumber   String    @map("account_number")
  accountName     String    @map("account_name")
  lastTransferAt  DateTime? @map("last_transfer_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bankCode, accountNumber])
  @@map("saved_accounts")
}
